{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://purps.lol/api/$1"
    },
    {
      "source": "/_next/data/(.*)",
      "destination": "https://purps.lol/_next/data/$1"
    },
    {
      "source": "/_next/image(.*)",
      "destination": "https://purps.lol/_next/image$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "https://purps.lol/images/$1"
    },
    {
      "source": "/brand/(.*)",
      "destination": "https://purps.lol/brand/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
